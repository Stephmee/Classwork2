-- 1. Създайте подходяща база данни и схема към нея;
CREATE DATABASE IF NOT EXISTS STORK_CUSTOMER_ORDERS_JSON;
-- 2. Създайте ФАЙЛ ФОРМАТ, подходящ за СТЕИДЖА
CREATE FILE FORMAT IF NOT EXISTS JSON_FORMAT
TYPE='JSON';
-- 3. Създайте вътрешен СТЕИДЖ - добавете, коментар към стеиджа (проверете в документацията);
CREATE SCHEMA IF NOT EXISTS STG_SCHEMA;

CREATE STAGE IF NOT EXISTS INTERNAL_STAGE;

COMMENT ON STAGE STORK_CUSTOMER_ORDERS_JSON.STG_SCHEMA.INTERNAL_STAGE IS 'INTERNAL STAGE FOR LOADING JSON DATA';

-- 4. Качете JSON файловете.

-- 5. Създайте подходящи таблици за суровите данни:
-- - raw_customers_json
-- - raw_orders_json

CREATE TABLE IF NOT EXISTS raw_customers_json
(
    JSON_DATA VARIANT
);

DROP TABLE RAW_CUSTOMERS_JSON;

CREATE TABLE IF NOT EXISTS raw_orders_json
(
    JSON_DATA VARIANT
);


DROP TABLE raw_orders_json;

CREATE SCHEMA IF NOT EXISTS table_schema;
use schema table_schema;

-- 6. Създайте подходящи таблици за същинските данни:
-- - td_customers
-- - td_orders
-- - td_order_items

CREATE TABLE IF NOT EXISTS td_customers
(
    customer_id VARCHAR,
    name VARCHAR,
    email VARCHAR,
    registration_date DATE,
      street VARCHAR,
      city VARCHAR,
      zip_code NUMBER,
    loyalty_points NUMBER
);

CREATE TABLE IF NOT EXISTS td_orders
(
    order_id VARCHAR,
    customer_id VARCHAR,
    order_date TIMESTAMP,
    total_amount NUMBER,
    items variant,
    shipping_method VARCHAR
);


CREATE TABLE IF NOT EXISTS td_order_items
(
   product_id VARCHAR,
   name VARCHAR,
   quantity NUMBER,
   price NUMBER
);

-- 7. Заредете данните от JSON файловете - в таблиците за сурови данни



COPY INTO STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.RAW_CUSTOMERS_JSON
FROM @STORK_CUSTOMER_ORDERS_JSON.STG_SCHEMA.INTERNAL_STAGE/customers_data.json
FILE_FORMAT=
(
FORMAT_NAME=STORK_CUSTOMER_ORDERS_JSON.PUBLIC.JSON_FORMAT
);

select * from raw_orders_json;

COPY INTO STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.raw_orders_json
FROM @STORK_CUSTOMER_ORDERS_JSON.STG_SCHEMA.INTERNAL_STAGE/orders_data.json
FILE_FORMAT=
(
FORMAT_NAME=STORK_CUSTOMER_ORDERS_JSON.PUBLIC.JSON_FORMAT
);

-- 8. Извлечете данните от суровите таблици и ги разпределете в td_* таблиците

INSERT INTO STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.td_customers (
  customer_id,
  name,
  email,
  registration_date,
  street,
  city,
  zip_code,
  loyalty_points
)
SELECT 
  value['customer_id']::STRING,
  value['name']::STRING,
  value['email']::STRING,
  value['registration_date']::DATE,
  value['address']['street']::STRING,
  value['address']['city']::STRING,
  value['address']['zip_code']::STRING,
  value['loyalty_points']::NUMBER
FROM STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.raw_customers_json,
     LATERAL FLATTEN(input => JSON_DATA);


   INSERT INTO STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.td_orders (
    order_id,
    customer_id,
    order_date,
    total_amount,
    items,
    shipping_method 
)
SELECT 
  value['order_id']::STRING,
  value['customer_id']::STRING,
  value['order_date']::DATE,
  value['total_amount']::NUMBER,
  value['items'],
  value['shipping_method']::STRING
FROM STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA. raw_orders_json,
     LATERAL FLATTEN(input => JSON_DATA);



SELECT * FROM td_order_items;

    INSERT INTO STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.td_order_items (
    product_id,
    name,
    quantity,
    price
)
SELECT
    item.value:product_id::STRING AS product_id,
    item.value:name::STRING AS name,
    item.value:quantity::INT AS quantity,
    item.value:price::FLOAT AS price
FROM 
    STORK_CUSTOMER_ORDERS_JSON.TABLE_SCHEMA.raw_orders_json,
    LATERAL FLATTEN(input => JSON_DATA:items) AS item;

     truncate table td_order_items;
     select * FROM td_order_items;

-- 9. Създайте таблица, която да съдържа агрегирана информация от броя на потребителите, които са се регистрирали до момента в системата.
CREATE TABLE IF NOT EXISTS TD_COUNT_CUSTOMERS
AS
SELECT  COUNT(customer_id) as count_cust
from td_customers;

truncate table TD_ORDER_ITEMS;
-- 10. Създайте таблица, която да агрегира общото количество продадени продукти и тяхната цена.

CREATE TABLE IF NOT EXISTS TD_SOLD_ITEMS
AS
SELECT 
  product_id, 
  name, 
  SUM(quantity) AS total_quantity, 
  price
FROM TD_ORDER_ITEMS
GROUP BY product_id, name, price
ORDER BY product_id;

SELECT * FROM TD_ORDER_ITEMS;


-- 11. Изтриите СУРОВИТЕ таблици.
truncate table raw_customers_json;
truncate table raw_orders_json;
